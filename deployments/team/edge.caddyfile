{
    admin off
    auto_https off
    persist_config off
    servers {
        trusted_proxies static {$TEAM_EDGE_TRUSTED_PROXY_IPS:127.0.0.1 ::1}
        client_ip_headers X-Real-IP
    }
}

:18410 {
    reverse_proxy {$TEAM_GATEWAY_UPSTREAM:gateway:18410} {
        header_up X-Real-IP {client_ip}
    }
}
